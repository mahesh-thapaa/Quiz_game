rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ──────────────────────────────────────────────────────────────
    // Each user can only read/write their own profile.
    // Admins or Cloud Functions should handle cross-user operations.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false; // Deletion handled by Cloud Functions
    }

    // ── Username reservations ──────────────────────────────────────────────
    // Anyone authenticated can read to check availability.
    // Only the owner (uid match) can write their own reservation.
    match /usernames/{username} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && resource == null
                   && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }

    // ── User progress (per-category, per-level) ────────────────────────────
    match /user_progress/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Streaks ────────────────────────────────────────────────────────────
    match /streaks/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Quiz content (read-only for clients) ──────────────────────────────
    match /quizzes/{quizId} {
      allow read: if request.auth != null;
      allow write: if false; // Managed via Admin SDK / Cloud Functions
    }

    match /quizzes/{quizId}/levels/{levelId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /quizzes/{quizId}/levels/{levelId}/questions/{questionId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
